{
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "nextjs",
      "installCommand": "npm install --legacy-peer-deps"
    },
    "backend": {
      "root": "backend",
      "framework": "fastapi",
      "entrypoint": "server:app"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "type": "service", "service": "backend" } },
    { "source": "/(.*)", "destination": { "type": "service", "service": "frontend" } }
  ]
}
